<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>Харест - 3D Дуэль</title>
    <style>
        body, html { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #000; font-family: sans-serif; }
        #canvas-container { width: 100vw; height: 100vh; display: block; }
        #overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.95); color: #fff; display: flex; justify-content: center; align-items: center; font-size: 24px; z-index: 999; }
        #ui { position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%); display: none; gap: 20px; z-index: 10; }
        .btn { padding: 15px 30px; background: #8b0000; color: #fff; border: 2px solid #ff0000; font-size: 18px; cursor: pointer; border-radius: 8px; text-transform: uppercase; font-weight: bold; }
        .btn:hover { background: #ff0000; }
        #status { position: absolute; top: 20px; width: 100%; text-align: center; color: #fff; font-size: 22px; text-shadow: 0 0 10px #ff0000; }
    </style>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>

    <div id="overlay">Проверка доступа...</div>
    <div id="status"></div>
    <div id="canvas-container"></div>

    <div id="ui">
        <button class="btn" onclick="makeShot('self')">В СЕБЯ</button>
        <button class="btn" onclick="makeShot('enemy')">В НЕГО</button>
    </div>

    <script>
        let scene, camera, renderer, shotgun;
        const overlay = document.getElementById('overlay');
        const ui = document.getElementById('ui');
        const status = document.getElementById('status');

        function init3D() {
            scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x050505, 0.05);

            camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            camera.position.set(0, 1.5, 3);

            renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
            document.getElementById('canvas-container').appendChild(renderer.domElement);

            // Освещение
            const light = new THREE.PointLight(0xff4400, 2, 10);
            light.position.set(0, 2, 1);
            scene.add(light);
            scene.add(new THREE.AmbientLight(0x222222));

            // Заглушка модели дробовика (Цилиндр + Бокс)
            const group = new THREE.Group();
            const barrelGeo = new THREE.CylinderGeometry(0.05, 0.05, 1.2, 16);
            const barrelMat = new THREE.MeshStandardMaterial({ color: 0x111111, metalness: 0.8, roughness: 0.2 });
            const barrel = new THREE.Mesh(barrelGeo, barrelMat);
            barrel.rotation.x = Math.PI / 2;
            group.add(barrel);

            shotgun = group;
            shotgun.position.set(0.3, -0.4, -0.8);
            scene.add(shotgun);

            window.addEventListener('resize', onWindowResize);
            animate();
        }

        function onWindowResize() {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        }

        function animate() {
            requestAnimationFrame(animate);
            renderer.render(scene, camera);
        }

        // Проверка прав (Симуляция авторизации по IP)
        setTimeout(() => {
            const isAllowed = true; // Заменяется динамической проверкой с сервера
            if (!isAllowed) {
                overlay.innerText = "Простите, вы не участвуете в игре.";
            } else {
                overlay.style.display = 'none';
                init3D();
                startPreparation();
            }
        }, 1000);

        function startPreparation() {
            status.innerText = "ПОДГОТОВКА: 3";
            let count = 3;
            const timer = setInterval(() => {
                count--;
                if (count > 0) {
                    status.innerText = `ПОДГОТОВКА: ${count}`;
                } else {
                    clearInterval(timer);
                    status.innerText = "ПАТРОНЫ: 2 БОЕВЫХ | 2 ХОЛОСТЫХ";
                    setTimeout(() => {
                        ui.style.display = 'flex';
                        status.innerText = "ВАШ ХОД";
                    }, 2000);
                }
            }, 1000);
        }

        function makeShot(target) {
            ui.style.display = 'none';
            // Простая анимация отдачи
            shotgun.position.z += 0.2;
            setTimeout(() => shotgun.position.z -= 0.2, 100);

            status.innerText = target === 'self' ? "ВЫ ВЫСТРЕЛИЛИ В СЕБЯ!" : "ВЫ ВЫСТРЕЛИЛИ В ОППОНЕНТА!";
        }
    </script>
</body>
</html>
